{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HANE Voyage",
  "version": "0.1.0",
  "identifier": "io.github.hane-lab.voyage",
  "build": {
    "devUrl": "http://127.0.0.1:8770",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "火羽舰队",
        "width": 1280,
        "height": 800,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"]
      }
    }
  }
}
